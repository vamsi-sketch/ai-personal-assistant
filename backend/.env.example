# Adaptive AI Personal Learning Assistant - Backend Environment Variables
PORT=8000
HOST=0.0.0.0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_learning_db
JWT_SECRET=super-secret-jwt-key-for-college-demo-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini API Key (Required for RAG AI Tutor & Quiz generation)
GEMINI_API_KEY=your_gemini_api_key_here

# DKT Model Configuration
DKT_MODEL_PATH=ai_models/trained_models/dkt_model.pth
NUM_TOPICS=50
EMBEDDING_DIM=64
HIDDEN_DIM=128

# Vector DB
FAISS_INDEX_PATH=vector_db/faiss_index/adaptive_learning.index
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
